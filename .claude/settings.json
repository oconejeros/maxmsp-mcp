{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/sync_max_js.py",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Syncing js to the Max device folder"
          }
        ]
      }
    ]
  }
}
